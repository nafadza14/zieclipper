# Copy this file to .env.local and fill in the values you need.
# Required:
ANTHROPIC_API_KEY=sk-ant-...

# Optional — only needed if you pick these providers in the UI:
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Only change these if you're NOT using Docker/docker-compose (which already
# sets sensible defaults) — e.g. running services manually on bare Windows.
# PYTHON_SERVICE_URL=http://localhost:8002
# FFMPEG_PATH=ffmpeg
# YTDLP_PATH=yt-dlp
