# Copy to .env.local for local dev, or set as environment variables in the
# Vercel project dashboard. This app now runs the whole pipeline itself
# (yt-dlp, ffmpeg, and the LLM calls) inside its own Next.js API routes --
# there is no separate worker/VPS to configure.

# Required — same Supabase project for both auth and job storage/media.
# Dashboard > Project Settings > API. The anon key is safe to expose to the
# browser (that's what NEXT_PUBLIC_ means) as long as Row Level Security is
# enabled on jobs/export_jobs/storage.objects, which
# supabase/migrations/0001_jobs_and_exports.sql sets up. Run that migration
# once against this project before deploying.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# At least one LLM provider key is required, matching whichever
# model/provider pair the app is configured to use (see app/page.tsx and
# components/editor/panels/ExportPanel.tsx for where provider is chosen).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SUMOPOD_API_KEY=
GEMINI_API_KEY=
# Optional Groq key for Whisper transcription fallback (when a YouTube video
# has no captions of any kind). Free tier from https://console.groq.com.
GROQ_API_KEY=

# --- Cloudflare R2 (object storage for rendered media) ---
# Get these from Cloudflare dashboard → R2 → your bucket → API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=zieclip
# Optional: use the jurisdiction-specific endpoint verbatim if the R2 dashboard
# gave you one; otherwise leave blank and the code assembles the standard URL
# https://<accountId>.r2.cloudflarestorage.com from R2_ACCOUNT_ID.
R2_ENDPOINT=

# --- YouTube OAuth (Fase D — publish to YouTube Shorts) ---
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
# 1. Create a new OAuth 2.0 Client ID (Type: Web application)
# 2. Enable YouTube Data API v3 in the same project
# 3. Add authorized redirect URI: <your-origin>/api/social/youtube/callback
#    - dev: http://localhost:3000/api/social/youtube/callback
#    - prod: https://your-domain.com/api/social/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The origin the app is served from — MUST match a registered redirect URI's origin.
OAUTH_REDIRECT_ORIGIN=http://localhost:3000

# YouTube cookies — effectively REQUIRED on Vercel. YouTube blocks its
# datacenter IPs with "Sign in to confirm you're not a bot", and the only
# reliable fix is passing cookies from a signed-in YouTube session.
#
# Preferred: paste the WHOLE cookies.txt, base64-encoded, into this one var.
# The app writes it to /tmp at request time (keeps the secret out of git).
#   macOS/Linux:  base64 -w0 cookies.txt   (or `base64 cookies.txt` on macOS)
#   Windows PS:   [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# See DEPLOY-VERCEL-SUPABASE.md for how to export cookies.txt from your browser.
YTDLP_COOKIES_B64=

# Alternative: an explicit path to a cookies.txt that exists at runtime
# (e.g. committed into the repo — not recommended for a real cookie).
YTDLP_COOKIES_PATH=

# Optional overrides — only needed if you want to point at binaries other
# than the ones server/binaries.ts resolves automatically (bundled
# yt-dlp_linux + @ffmpeg-installer/@ffprobe-installer on Vercel, PATH
# locally).
FFMPEG_PATH=
FFPROBE_PATH=
YTDLP_PATH=
