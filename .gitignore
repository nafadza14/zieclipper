# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# YouTube cookies — MUST never be committed. These are session cookies
# from a signed-in YouTube account; committing them = anyone with repo
# access can hijack that account.
*cookies*.txt
_cookies_b64.txt
www.youtube.com_cookies.txt

# Dev-only sandbox. Anything you want to keep on your laptop but NOT push
# to GitHub — cookies, personal notes, test scripts, scratch files,
# .env backups, downloaded test videos — goes in /dev-only/.
# The folder itself IS tracked (via .gitkeep) so the path always exists
# on both machines; the contents never leave your laptop.
/dev-only/*
!/dev-only/.gitkeep
!/dev-only/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/
dist/
*.egg

# tmp / uploads
/tmp/

# yt-dlp binary -- fetched by scripts/fetch-ytdlp.js during `npm install`
# on Vercel (postinstall), not committed. See server/binaries.ts.
/bin/

# flat copies created during scaffold (duplicate dirs)
apiservices/
appapidownload/
appapiexport/
appapijobs/
appapithumbnail/
appapivideo/
appclips/
appeditor/
componentsclips/
componentseditorpanels/
componentseditorpresets/
componentsui/
componentsurl-input/
publicfonts/
